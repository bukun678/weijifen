    function drawSlope(){const m=Number(slopeSlider.value),svg=slopeChart;clear(svg);const s=scale([-4,4],[-5,5]);axes(svg,s);svg.appendChild(node('line',{x1:s.x(-3.5),y1:s.y(-3.5*m),x2:s.x(3.5),y2:s.y(3.5*m),stroke:'#276fbf','stroke-width':4}));svg.appendChild(node('line',{x1:s.x(0),y1:s.y(0),x2:s.x(1),y2:s.y(0),stroke:'#16835a','stroke-width':4}));svg.appendChild(node('line',{x1:s.x(1),y1:s.y(0),x2:s.x(1),y2:s.y(m),stroke:'#c44954','stroke-width':4}));slopeValue.textContent=formatNumber(m);riseValue.textContent=formatNumber(m);slopeMeaning.textContent=m===0?'每走 1，不升不降':`每走 1，${m>0?'上升':'下降'} ${formatNumber(Math.abs(m))}`}
    function limitFn(x){return Math.abs(x-1)<1e-6?NaN:(x*x-1)/(x-1)}
    function drawLimit(){const x=Number(limitSlider.value),svg=limitChart;clear(svg);const s=scale([-1,3],[-1,5]);axes(svg,s);svg.appendChild(node('path',{d:path(v=>v+1,-1,3,s),fill:'none',stroke:'#276fbf','stroke-width':4}));svg.appendChild(node('circle',{cx:s.x(1),cy:s.y(2),r:8,fill:'#fbfcff',stroke:'#c44954','stroke-width':4}));const y=limitFn(x);if(Number.isFinite(y)){svg.appendChild(node('circle',{cx:s.x(x),cy:s.y(y),r:6,fill:'#16835a'}))}limitX.textContent=formatNumber(x);limitTable.innerHTML=[x-.2,x-.05,x,x+.05,x+.2].map(v=>`<tr><td>${formatNumber(v)}</td><td>${Number.isFinite(limitFn(v))?formatNumber(limitFn(v)):'不能直接算'}</td></tr>`).join('')}
    function drawDerivative(){const x=Number(derivX.value),h=Number(derivH.value),svg=derivativeChart;clear(svg);const s=scale([-4,4],[-1,10]);axes(svg,s);svg.appendChild(node('path',{d:path(v=>v*v,-3.2,3.2,s),fill:'none',stroke:'#276fbf','stroke-width':4}));const y=x*x,x2=x+h,y2=x2*x2,sec=(y2-y)/(x2-x),tan=derivativeAt(v=>v*v,x);svg.appendChild(node('line',{x1:s.x(x-1.2),y1:s.y(y-1.2*tan),x2:s.x(x+1.2),y2:s.y(y+1.2*tan),stroke:'#c44954','stroke-width':4}));svg.appendChild(node('line',{x1:s.x(x),y1:s.y(y),x2:s.x(x2),y2:s.y(y2),stroke:'#16835a','stroke-width':4,'stroke-dasharray':'7 5'}));svg.appendChild(node('circle',{cx:s.x(x),cy:s.y(y),r:7,fill:'#c44954'}));svg.appendChild(node('circle',{cx:s.x(x2),cy:s.y(y2),r:7,fill:'#16835a'}));derivXText.textContent=formatNumber(x);derivHText.textContent=formatNumber(h);secantText.textContent=formatNumber(sec);tangentText.textContent=formatNumber(tan)}
    function drawOpt(){const a=Number(optA.value),svg=optChart;clear(svg);const s=scale([0,8],[-14,12]);axes(svg,s,'x','P');const fn=x=>-a*(x-4)*(x-4)+9;svg.appendChild(node('path',{d:path(fn,0,8,s),fill:'none',stroke:'#276fbf','stroke-width':4}));svg.appendChild(node('line',{x1:s.x(4),y1:s.y(-12),x2:s.x(4),y2:s.y(9),stroke:'#c44954','stroke-width':3,'stroke-dasharray':'7 5'}));svg.appendChild(node('circle',{cx:s.x(4),cy:s.y(9),r:8,fill:'#c44954'}));optAText.textContent=formatNumber(a);optX.textContent='x=4'}
    function drawRiemann(){const n=Number(rectSlider.value),svg=riemannChart;clear(svg);const s=scale([-.2,3.4],[-.5,10]);axes(svg,s);const w=3/n;for(let i=0;i<n;i++){const m=w*(i+.5),h=m*m;svg.appendChild(node('rect',{x:s.x(i*w),y:s.y(h),width:Math.max(1,s.x(w)-s.x(0)-1),height:s.y(0)-s.y(h),fill:'#f0b74c',opacity:.45,stroke:'#d69b31'}))}svg.appendChild(node('path',{d:path(x=>x*x,0,3,s),fill:'none',stroke:'#276fbf','stroke-width':4}));const area=riemannSum(x=>x*x,0,3,n);rectText.textContent=n;areaText.textContent=formatNumber(area);errText.textContent=formatNumber(Math.abs(9-area))}
    function drawAccum(){const x=Number(accumSlider.value),k=Number(rateSlider.value),svg=accumChart;clear(svg);const s=scale([0,5.5],[-.5,22]);axes(svg,s);const fn=v=>k*v;for(let i=0;i<28;i++){const w=x/28,m=w*(i+.5),h=fn(m);svg.appendChild(node('rect',{x:s.x(i*w),y:s.y(h),width:Math.max(1,s.x(w)-s.x(0)-1),height:s.y(0)-s.y(h),fill:'#16835a',opacity:.3}))}svg.appendChild(node('path',{d:path(fn,0,5,s),fill:'none',stroke:'#276fbf','stroke-width':4}));accumText.textContent=formatNumber(x);rateText.textContent=formatNumber(k);currentRate.textContent=formatNumber(k*x);accumArea.textContent=formatNumber(k*x*x/2)}
    const done=new Set();let correct=0,attempts=0;
    function updateProgress(){const total=document.querySelectorAll('[data-question]').length;progressText.textContent=`${done.size} / ${total} 题完成`;progressBar.style.width=`${done.size/total*100}%`;diagnosticText.textContent=attempts?`已尝试 ${attempts} 次，正确 ${correct} 次。若低于 80%，先按错题所在单元回看例题，再做综合测验。`:'做几题后，这里会根据错误类型提示你回看哪一章。'}
    function bindPractice(){document.querySelectorAll('.practice').forEach(card=>{const btn=card.querySelector('button'),input=card.querySelector('input,select'),fb=card.querySelector('.feedback');btn.addEventListener('click',()=>{attempts++;const ok=checkAnswer(input.value,card.dataset.answer);if(ok){if(!done.has(card.dataset.question)){done.add(card.dataset.question);correct++}fb.textContent='答对了。再用一句话解释为什么，才是真会用。';fb.className='feedback ok'}else{fb.textContent=`还不对。先看提示；错因多半是工具选错、公式漏项、单位没写或代数变形不稳。`;fb.className='feedback no'}updateProgress()})})}
    function init(){drawHero();drawSlope();drawLimit();drawDerivative();drawOpt();drawRiemann();drawAccum();bindPractice();updateProgress();slopeSlider.oninput=drawSlope;limitSlider.oninput=drawLimit;derivX.oninput=drawDerivative;derivH.oninput=drawDerivative;optA.oninput=drawOpt;rectSlider.oninput=drawRiemann;accumSlider.oninput=drawAccum;rateSlider.oninput=drawAccum}
    init();
  </script>
